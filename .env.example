# Copy to .env and adjust. Never commit the real .env.

# Required: a long random string, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
DOCPILOT_JWT_SECRET=

# "demo" runs fully offline (no API key, no cost). "claude" uses the Anthropic API.
DOCPILOT_LLM_PROVIDER=demo
DOCPILOT_LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# Weekly deadline emails. Leave empty to use the bundled Mailpit inbox (http://localhost:8025).
# For a real provider set host, port 587, STARTTLS=true and credentials.
DOCPILOT_SMTP_HOST=
DOCPILOT_SMTP_PORT=
DOCPILOT_SMTP_STARTTLS=
DOCPILOT_SMTP_USER=
DOCPILOT_SMTP_PASSWORD=
